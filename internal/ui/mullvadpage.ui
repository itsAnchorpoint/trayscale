<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.96.1 -->
<interface>
  <!-- interface-name mullvadpage.ui -->
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="Page">
    <property name="title" translatable="yes">Mullvad Exit Nodes</property>
    <child>
      <object class="AdwClamp">
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="AdwPreferencesGroup">
                <property name="description">Choose who manages the active exit node</property>
                <property name="title">Exit Node Mode</property>
                <child>
                  <object class="AdwSwitchRow" id="AutomaticExitNodeRow">
                    <property name="subtitle">Tailscale chooses from all permitted exit nodes and keeps working when Trayscale is closed</property>
                    <property name="title">Automatic</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="HealthCheckedExitNodeRow">
                    <property name="subtitle">Trayscale checks real internet access and switches between Mullvad nodes</property>
                    <property name="title">Automatic with Connection Checks</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSearchEntry" id="SearchEntry">
                <property name="hexpand">True</property>
                <property name="placeholder-text">Search locations</property>
              </object>
            </child>
            <child>
              <object class="GtkListBox" id="LocationList">
                <property name="css-classes">boxed-list</property>
                <property name="selection-mode">none</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="EmptyLabel">
                <property name="css-classes">dim-label</property>
                <property name="halign">center</property>
                <property name="label" translatable="yes">No matching exit nodes</property>
                <property name="margin-top">24</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="AutoSwitchStatus">
                <property name="halign">start</property>
                <property name="label">Exit node: off</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="LastAutoSwitchStatus">
                <property name="halign">start</property>
                <property name="label">Last auto-switch: never</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="wrap">True</property>
                <property name="xalign">0</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
